# Salin file ini jadi .env dan isi nilainya. JANGAN commit .env yang berisi
# nilai asli — pastikan .env ada di .gitignore.

# --- Server ---
PORT=8080
ENV=development

# --- Database (Supabase PostgreSQL) ---
# Gunakan connection string DIRECT atau SESSION POOLER dari dashboard Supabase
# (Project Settings > Database), dengan role yang BYPASS Row Level Security
# (default: role "postgres"). JANGAN pakai anon key di sini — anon key untuk
# auth/storage di frontend, bukan untuk koneksi database backend.
# Lihat .agents/rules/30-security.md bagian "Koneksi database".
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# --- Supabase Auth (verifikasi JWT di middleware) ---
# Project URL dan JWT secret dari dashboard Supabase (Project Settings > API).
SUPABASE_PROJECT_URL=https://[PROJECT-REF].supabase.co
SUPABASE_JWT_SECRET=[JWT_SECRET]

# --- CORS ---
# Origin frontend yang diizinkan memanggil API ini (dev dan/atau produksi).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Logging ---
LOG_LEVEL=info

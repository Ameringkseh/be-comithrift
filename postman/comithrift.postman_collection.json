{
  "info": {
    "_postman_id": "comithrift-backend-collection",
    "name": "COMITHRIFT Backend API",
    "description": "Koleksi Postman untuk pengujian REST API COMITHRIFT (Tabel 3.7 & Tabel 4.2 Proposal)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Katalog Produk (Publik)",
      "item": [
        {
          "name": "P-01 - Mengambil daftar produk katalog dengan filter (expect 200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/produk?kategori=Jaket&ukuran=L",
              "host": ["{{base_url}}"],
              "path": ["api", "produk"],
              "query": [
                {
                  "key": "kategori",
                  "value": "Jaket"
                },
                {
                  "key": "ukuran",
                  "value": "L"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response format matches convention', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('data');",
                  "    pm.expect(jsonData).to.have.property('meta');",
                  "    pm.expect(Array.isArray(jsonData.data)).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Mengambil detail produk by ID (expect 200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/produk/1",
              "host": ["{{base_url}}"],
              "path": ["api", "produk", "1"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Data detail produk valid', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('data');",
                  "    pm.expect(jsonData.data).to.have.property('id_produk');",
                  "    pm.expect(jsonData.data).to.have.property('nama_produk');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Mengambil detail produk ID tidak ada (expect 404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/produk/99999",
              "host": ["{{base_url}}"],
              "path": ["api", "produk", "99999"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "pm.test('Error code is TIDAK_DITEMUKAN', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error.code).to.eql('TIDAK_DITEMUKAN');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin - Produk",
      "item": [
        {
          "name": "Tambah produk baru oleh Admin/Relawan (expect 201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_relawan}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama_produk\": \"Crewneck Vintage Oversize\",\n  \"harga\": 65000,\n  \"deskripsi\": \"Sweater crewneck warna abu misty, bahan fleece hangat.\",\n  \"ukuran\": \"XL\",\n  \"kondisi\": \"Sangat Baik\",\n  \"kategori\": \"Sweater\",\n  \"foto\": \"https://supabase.co/storage/v1/object/public/produk/sample-crewneck.jpg\",\n  \"status\": \"tersedia\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/produk",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "produk"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Produk berhasil dibuat', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.have.property('id_produk');",
                  "    pm.expect(jsonData.data.nama_produk).to.eql('Crewneck Vintage Oversize');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "P-04 - Tambah produk tanpa token autentikasi (expect 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama_produk\": \"Jaket Windbreaker\",\n  \"harga\": 50000,\n  \"ukuran\": \"L\",\n  \"kondisi\": \"Baik\",\n  \"kategori\": \"Jaket\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/produk",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "produk"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test('Error code is TOKEN_TIDAK_ADA', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error.code).to.eql('TOKEN_TIDAK_ADA');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Tambah produk dengan input tidak valid (harga negatif) (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_relawan}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama_produk\": \"Baju Rusak\",\n  \"harga\": -1000,\n  \"ukuran\": \"M\",\n  \"kondisi\": \"Bekas\",\n  \"kategori\": \"Kaos\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/produk",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "produk"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Error code is VALIDASI_GAGAL', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error.code).to.eql('VALIDASI_GAGAL');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update data produk (PATCH) (expect 200)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_relawan}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"harga\": 70000,\n  \"deskripsi\": \"Deskripsi produk telah diperbarui oleh relawan.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/produk/1",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "produk", "1"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Harga terupdate', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.harga).to.eql(70000);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Hapus produk (DELETE) (expect 200)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/produk/4",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "produk", "4"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Pesan hapus berhasil', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.message).to.eql('Produk berhasil dihapus.');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}


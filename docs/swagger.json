    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/api/admin/donasi/penyaluran": {
            "post": {
                "description": "Mencatat kegiatan penyaluran donasi ke penerima manfaat oleh Admin (nominal tidak boleh melebihi saldo kas donasi yang tersedia)",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Donasi (Admin)"
                ],
                "summary": "Catat Penyaluran Donasi",
                "parameters": [
                    {
                        "description": "Data penyaluran donasi",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.CreatePenyaluranRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/handlers.PenyaluranDonasiResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                },
                "security": [
                    {
                        "BearerAuth": []
                    }
                ]
            }
        },
        "/api/admin/pesanan": {
            "get": {
                "description": "Mengambil daftar pesanan pelanggan dengan filter status opsional (khusus peran Admin)",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Pesanan (Admin)"
                ],
                "summary": "Daftar Seluruh Pesanan",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Filter status pesanan (menunggu_pembayaran, dibayar, selesai, dibatalkan)",
                        "name": "status",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.PesananListResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                },
                "security": [
                    {
                        "BearerAuth": []
                    }
                ]
            }
        },
        "/api/admin/pesanan/{id}/status": {
            "patch": {
                "description": "Memperbarui status pesanan (misal verifikasi pembayaran atau pembatalan) sesuai alur state machine",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Pesanan (Admin)"
                ],
                "summary": "Perbarui Status Pesanan",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID Pesanan",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Status baru pesanan",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.UpdateStatusPesananRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.PesananSingleResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                },
                "security": [
                    {
                        "BearerAuth": []
                    }
                ]
            }
        },
        "/api/admin/produk": {
            "post": {
                "description": "Menambahkan produk baru ke katalog oleh Relawan atau Admin",

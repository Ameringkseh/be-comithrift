{
    "swagger": "2.0",
    "info": {
        "description": "REST API Backend untuk Platform Pemasaran Pakaian Bekas \u0026 Donasi Tebar Cinta (COMITHRIFT).",
        "title": "COMITHRIFT Backend API",
        "contact": {
            "name": "Rafli Mochamad Ramadhan (Backend Developer)"
        },

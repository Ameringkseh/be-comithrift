                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                },
                "security": [
                    {
                        "BearerAuth": []
                    }
                ]
            }
        },
        "/api/admin/produk/{id}": {
            "delete": {
                "description": "Menghapus produk dari katalog jika tidak sedang berada dalam pesanan aktif",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Produk (Admin/Relawan)"
                ],
                "summary": "Hapus Produk",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID Produk",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.DeleteSuccessResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                },
                "security": [
                    {
                        "BearerAuth": []
                    }
                ]
            },
            "patch": {
                "description": "Memperbarui informasi atau status produk oleh Relawan atau Admin",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Produk (Admin/Relawan)"
                ],
                "summary": "Perbarui Data Produk",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID Produk",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Field produk yang akan diperbarui",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.UpdateProdukRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.ProdukSingleResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                },
                "security": [
                    {
                        "BearerAuth": []
                    }
                ]
            }
        },
        "/api/admin/rekap": {
            "get": {
                "description": "Mengambil statistik rekapitulasi jumlah pesanan per status, total penjualan, donasi, dan inventaris produk",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Rekapitulasi (Admin)"
                ],
                "summary": "Rekapitulasi Data Penjualan \u0026 Donasi",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.RekapDataResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                },
                "security": [
                    {
                        "BearerAuth": []
                    }
                ]
            }
        },
        "/api/donasi/ringkasan": {
            "get": {
                "description": "Mengambil ringkasan akumulasi donasi terkumpul, donasi tersalurkan, saldo donasi, riwayat penyaluran, dan info program Tebar Cinta",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Donasi (Publik)"
                ],
                "summary": "Ringkasan Transparansi Donasi",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.RingkasanDonasiResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/midtrans/notification": {
            "post": {
                "description": "Menerima callback webhook status pembayaran dari Midtrans, memverifikasi signature SHA-512, dan memperbarui status pesanan menjadi dibayar atau dibatalkan secara otomatis",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Midtrans"
                ],
                "summary": "Webhook Notifikasi Midtrans",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/pesanan": {
            "post": {
                "description": "Membuat pesanan baru secara atomik dengan mengunci baris produk, menghitung ulang total belanja, dan menyertakan donasi sukarela",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Pesanan (Publik)"
                ],
                "summary": "Buat Pesanan Baru (Checkout)",
                "parameters": [
                    {
                        "description": "Data checkout pesanan",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.CreatePesananRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/handlers.PesananSingleResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/produk": {
            "get": {
                "description": "Mengambil daftar produk pakaian bekas yang tersedia untuk katalog publik dengan filter opsional",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Produk (Publik)"
                ],
                "summary": "Daftar Katalog Produk",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Filter kategori produk (misal: Jaket, Kemeja, Kaos)",
                        "name": "kategori",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Filter ukuran produk (misal: S, M, L, XL)",
                        "name": "ukuran",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Filter status produk (default: tersedia)",
                        "name": "status",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.ProdukListResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/produk/{id}": {
            "get": {
                "description": "Mengambil rincian informasi satu produk berdasarkan ID produk",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Produk (Publik)"
                ],
                "summary": "Detail Produk",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID Produk",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.ProdukSingleResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/healthz": {
            "get": {
                "description": "Memeriksa status keaktifan server REST API dan konektivitas basis data Supabase",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "System"
                ],
                "summary": "Health Check Service",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.HealthResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "handlers.CreatePenyaluranRequest": {
            "type": "object",
            "required": [
                "keterangan",
                "nominal"
            ],
            "properties": {
                "keterangan": {
                    "type": "string"
                },
                "nominal": {
                    "type": "integer"
                },
                "tanggal": {
                    "type": "string"
                }
            }
        },
        "handlers.CreatePesananRequest": {
            "type": "object",
            "required": [
                "items",
                "kontak_whatsapp",
                "metode_serah_terima",
                "nama_pembeli"
            ],
            "properties": {
                "catatan": {
                    "type": "string"
                },
                "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/definitions/handlers.ItemPesananReq"
                    }
                },
                "kontak_whatsapp": {
                    "type": "string"
                },
                "metode_serah_terima": {
                    "type": "string"
                },
                "nama_pembeli": {
                    "type": "string"
                },
                "nominal_donasi": {
                    "type": "integer",
                    "minimum": 0
                }
            }
        },
        "handlers.CreateProdukRequest": {
            "type": "object",
            "required": [
                "harga",
                "kategori",
                "kondisi",
                "nama_produk",
                "ukuran"
            ],
            "properties": {
                "deskripsi": {
                    "type": "string"
                },
                "foto": {
                    "description": "URL / path Supabase Storage yang sudah diunggah klien",
                    "type": "string"
                },
                "harga": {
                    "type": "integer"
                },
                "kategori": {
                    "type": "string"
                },
                "kondisi": {
                    "type": "string"
                },
                "nama_produk": {
                    "type": "string"
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "tersedia",
                        "dipesan",
                        "terjual"
                    ]
                },
                "ukuran": {
                    "type": "string"
                }
            }
        },
        "handlers.DeleteSuccessData": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "Produk berhasil dihapus."
                }
            }
        },
        "handlers.DeleteSuccessResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/handlers.DeleteSuccessData"
                }
            }
        },
        "handlers.ErrorDetail": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "TIDAK_DITEMUKAN"
                },
                "message": {
                    "type": "string",
                    "example": "Data tidak ditemukan."
                }
            }
        },
        "handlers.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "$ref": "#/definitions/handlers.ErrorDetail"
                }
            }
        },
        "handlers.HealthResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/handlers.HealthResponseData"
                }
            }
        },
        "handlers.HealthResponseData": {
            "type": "object",
            "properties": {
                "database": {
                    "type": "string",
                    "example": "connected"
                },
                "status": {
                    "type": "string",
                    "example": "ok"
                }
            }
        },
        "handlers.ItemPesananReq": {
            "type": "object",
            "required": [
                "id_produk"
            ],
            "properties": {
                "id_produk": {
                    "type": "integer"
                }
            }
        },
        "handlers.MetaTotal": {
            "type": "object",
            "properties": {
                "total": {
                    "type": "integer",
                    "example": 4
                }
            }
        },
        "handlers.PenyaluranDonasiResponse": {
            "type": "object",
